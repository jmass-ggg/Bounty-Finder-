# Copy to .env; never commit the populated file.
# Minimum USD reward for notifications; zero opts into every positive amount.
BOUNTYRADAR_MIN_REWARD_USD=0
BOUNTYRADAR_INITIAL_LOOKBACK_HOURS=8
BOUNTYRADAR_FRESH_LOOKBACK_HOURS=2
BOUNTYRADAR_GITHUB_FRESH_SEARCH_REQUESTS=8
BOUNTYRADAR_GITHUB_FRESH_SEARCH_TIMEOUT_SECONDS=20
BOUNTYRADAR_SCAN_INTERVAL_SECONDS=300
# Keep the overall budget below the unit's 270s startup timeout.
BOUNTYRADAR_RUN_TIMEOUT_SECONDS=240
BOUNTYRADAR_DATABASE_PATH=data/bountyradar.sqlite3
BOUNTYRADAR_LOG_LEVEL=INFO
BOUNTYRADAR_HTTP_TIMEOUT_SECONDS=30
# Use a least-privilege GitHub token for discovery and revalidation.
GITHUB_TOKEN=
# Email is opt-in. Only set true with a Gmail app password and trusted funding adapter.
EMAIL_ENABLED=false
BOUNTYRADAR_SMTP_HOST=smtp.gmail.com
BOUNTYRADAR_SMTP_PORT=465
BOUNTYRADAR_SMTP_TIMEOUT_SECONDS=20
# Absolute worker lifetime, including DNS, login, send and disconnect.
BOUNTYRADAR_SMTP_DELIVERY_TIMEOUT_SECONDS=20
BOUNTYRADAR_SMTP_USERNAME=
BOUNTYRADAR_SMTP_PASSWORD=
BOUNTYRADAR_EMAIL_TO=
BOUNTYRADAR_EMAIL_DAILY_CAP=20
BOUNTYRADAR_EMAIL_MAX_ATTEMPTS=3
BOUNTYRADAR_EMAIL_RETRY_BASE_SECONDS=60
BOUNTYRADAR_EMAIL_SENDING_LEASE_SECONDS=300
BOUNTYRADAR_REWARD_INCREASE_MIN_PERCENT=20
# GitHub discovery. List values use JSON arrays; [] disables that query family.
BOUNTYRADAR_CREATED_LOOKBACK_HOURS=24
BOUNTYRADAR_UPDATED_LOOKBACK_HOURS=24
BOUNTYRADAR_FUNDING_LOOKBACK_HOURS=72
BOUNTYRADAR_SEARCH_TERMS='["bounty","paid","reward","cash reward","paid issue"]'
BOUNTYRADAR_SEARCH_LABELS='["bounty","paid"]'
BOUNTYRADAR_MONETARY_TERMS='["USD"]'
BOUNTYRADAR_LANGUAGES='[]'
BOUNTYRADAR_GITHUB_MIN_REQUEST_INTERVAL_SECONDS=2
BOUNTYRADAR_GITHUB_MAX_RETRIES=3
BOUNTYRADAR_GITHUB_MAX_RATE_WAIT_SECONDS=300
BOUNTYRADAR_GITHUB_MAX_SEARCH_REQUESTS_PER_SCAN=60
BOUNTYRADAR_GITHUB_SEARCH_TIMEOUT_SECONDS=120
BOUNTYRADAR_GITHUB_MAX_INSPECTION_REQUESTS_PER_SCAN=60
BOUNTYRADAR_GITHUB_INSPECTION_TIMEOUT_SECONDS=90
# Set GITHUB_TOKEN in your local environment for authenticated searches.
# Phase 3 review and notification eligibility.
BOUNTYRADAR_ALLOWED_CURRENCIES='["USD"]'
BOUNTYRADAR_PREFERRED_REPOSITORIES='[]'
BOUNTYRADAR_PREFERRED_LANGUAGES='[]'
# Optional UTC ISO-8601 cutoffs; leave unset to disable.
# BOUNTYRADAR_EARLIEST_CREATED_AT=2026-01-01T00:00:00Z
# BOUNTYRADAR_EARLIEST_UPDATED_AT=2026-01-01T00:00:00Z
BOUNTYRADAR_NOTIFICATION_CATEGORIES='["FUNDED_EVIDENCE"]'
# Opt in to clearly labeled reward promises; availability/currency checks still apply.
BOUNTYRADAR_NOTIFICATION_MODE=confirmed_only
BOUNTYRADAR_NOTIFICATION_AVAILABILITIES='["AVAILABLE"]'
BOUNTYRADAR_HIGH_PRIORITY_SCORE=75
BOUNTYRADAR_MAX_VERIFICATIONS_PER_SCAN=20
BOUNTYRADAR_MAX_RECHECKS_PER_SCAN=5
# Empty trust lists mean no external result can be classified as funded.
BOUNTYRADAR_TRUSTED_FUNDING_HOSTS='[]'
BOUNTYRADAR_TRUSTED_FUNDING_PROVIDERS='[]'
# Six ranking weights must be nonnegative integers totaling 100.
BOUNTYRADAR_SCORE_WEIGHTS='{"funding":35,"freshness":15,"availability":20,"competition":10,"reward":10,"technology":10}'
# Optional thresholds for allowed non-USD currencies; no automatic conversion.
BOUNTYRADAR_CURRENCY_MINIMUMS='{}'
# A funded observation older than this remains evidence but is not current funding proof.
BOUNTYRADAR_FUNDING_EVIDENCE_MAX_AGE_HOURS=24
